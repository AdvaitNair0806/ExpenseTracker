# ==============================================================================
# AI-Powered Expense Tracker - Environment Configuration Template
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# CORS Settings (Comma-separated URLs for frontend allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI & LLM Service Configuration
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Database Configuration (Choose MongoDB or PostgreSQL)
# ------------------------------------------------------------------------------
# Set active database type: 'mongodb' or 'postgresql'
DATABASE_TYPE=mongodb

# Option 1: MongoDB Configuration
# Example: mongodb://localhost:27017 or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=expense_tracker_db

# Option 2: PostgreSQL Configuration (SQLAlchemy format)
# Example: postgresql+asyncpg://postgres:password@localhost:5432/expense_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=expense_tracker
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/expense_tracker

# Security / Authentication (Optional / Future expansion)
SECRET_KEY=supersecretkey_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
